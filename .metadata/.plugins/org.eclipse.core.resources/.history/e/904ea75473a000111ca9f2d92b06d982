body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #f4f6f9;
}

.app-container {
  text-align: center;
  padding: 20px;
}

.app-title {
  color: #2c3e50;
  margin-bottom: 20px;
}

.finder-container {
  background: #ffffff;
  border-radius: 8px;
  padding: 20px;
  width: 400px;
  margin: 0 auto;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.input-box {
  padding: 8px;
  width: 80%;
  margin-bottom: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

.button-group {
  margin: 10px 0;
}

/* Base button */
.btn {
  color: white;
  border: none;
  padding: 8px 12px;
  margin: 5px;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

/* Search Friends */
.btn.search {
  background-color: #e67e22;
}
.btn.search:hover {
  background-color: #d35400;
}

/* Friends of Friends */
.btn.fof {
  background-color: #27ae60;
}
.btn.fof:hover {
  background-color: #1e8449;
}

/* Mutual Friends */
.btn.mutual {
  background-color: #8e44ad;
}
.btn.mutual:hover {
  background-color: #6c3483;
}

/* Shortest Path */
.btn.path {
  background-color: #c0392b;
}
.btn.path:hover {
  background-color: #922b21;
}

